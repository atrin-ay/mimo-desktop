# MIMO Backend - Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server configuration
PORT=3001
NODE_ENV=development

# CORS - comma-separated list of allowed origins. Use "*" to allow all.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging - one of: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Database - path to SQLite database file (relative to project root)
DATABASE_PATH=./data/mimo.db

# AI Provider - "mock" for offline testing, "mimo" for HTTP, "mimo-cli" for native CLI
AI_PROVIDER=mock

# MiMo provider settings
MIMO_API_KEY=your-api-key-here
MIMO_BASE_URL=https://api.xiaomi.com/v1
MIMO_MODEL=MiMo-7B-RL

# Context Manager (Project Brain) - optional, enabled by default
# Set to "false" to disable the context manager entirely
CONTEXT_MANAGER_ENABLED=true

# Memory Provider - which provider to use for memory operations
# "chat-adapter" (default) uses the same provider as chat
MEMORY_PROVIDER=chat-adapter

# Memory Model - optional, overrides the default model for memory operations
# MEMORY_MODEL=

# Memory Queue - debounce time in milliseconds (default: 8000)
MEMORY_DEBOUNCE_MS=8000

# Memory Window - number of recent messages to include in memory agent context (default: 12)
MEMORY_WINDOW_SIZE=12
